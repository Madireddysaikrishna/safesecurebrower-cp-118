# ─────────────────────────────────────────────────────────────────
#  Vessel backend – required and optional environment variables
#  Copy this file to backend/.env and fill in your own values.
#  backend/.env is listed in .gitignore — never commit real secrets.
# ─────────────────────────────────────────────────────────────────

# ── Authentication ────────────────────────────────────────────────────────────

# Shared secret that every WebSocket client must include in its hello message.
# Must be identical to the VESSEL_TOKEN value in frontend/.env.local.
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VESSEL_TOKEN=change-me-before-use

# (Optional) HTTP origin allowed to call the REST API and upgrade to WS.
# Default: http://localhost:3002  (Next.js dev server)
# ALLOWED_ORIGIN=http://localhost:3002

# ── Google Safe Browsing (optional but recommended) ───────────────────────────
#
# When set, every URL is checked against Google's Safe Browsing threat lists
# (malware, phishing, unwanted software) before Chromium navigates to it.
# The key is forwarded securely into each Docker container at startup.
# It is NEVER sent to the browser client or embedded in the frontend bundle.
#
# Obtain a free key at:
#   https://console.cloud.google.com  →  APIs & Services  →  Safe Browsing API
#
# SAFE_BROWSING_API_KEY=your-google-safe-browsing-api-key-here

# Behaviour when the Safe Browsing API is unreachable or returns an error.
# This setting has NO effect when SAFE_BROWSING_API_KEY is absent.
#
#   false (default) — fail-closed / strict:
#     Navigation is blocked if the check cannot be completed.
#     Recommended for production deployments.
#
#   true — fail-open / permissive:
#     Navigation is allowed when the API is unavailable. Use only when
#     Safe Browsing availability is lower than your uptime target.
#
# SAFE_BROWSING_FAIL_OPEN=false

# Milliseconds before abandoning a Safe Browsing API call.
# Default: 3000.  Reduce to keep navigation latency tight.
# SAFE_BROWSING_TIMEOUT_MS=3000

