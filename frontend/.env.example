# ─────────────────────────────────────────────────────────────────
#  Vessel frontend – required environment variables
#  Copy this file to frontend/.env.local and fill in your own values.
#  frontend/.env.local is listed in .gitignore — never commit real secrets.
# ─────────────────────────────────────────────────────────────────

# Shared secret — must be identical to the VESSEL_TOKEN in backend/.env.
# NOT prefixed with NEXT_PUBLIC_ so it is never compiled into the JS bundle.
# It is served at runtime through the server-side /api/token route.
VESSEL_TOKEN=change-me-before-use

# (Optional) Backend WebSocket URL. Default: ws://localhost:3000
# Prefix with NEXT_PUBLIC_ because this value goes to the browser.
# NEXT_PUBLIC_BACKEND_URL=ws://localhost:3000
